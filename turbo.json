{
	"ui": "tui",
	"$schema": "https://turbo.build/schema.json",

	"globalEnv": ["NODE_*", "VITE_*"],
	"globalDependencies": ["bun.lock", "biome.json", "tsconfig.json", "./packages/linter/src/*.grit"],

	"tasks": {
		"dev:client": { "cache": false, "persistent": true },
		"dev:server": { "cache": false, "persistent": true },

		"build:client": { "dependsOn": ["^type-check"], "outputs": ["dist/**"] },
		"build:server": { "dependsOn": ["^type-check"], "outputs": ["dist/**"] },

		"fix": { "dependsOn": ["^fix"] },
		"lint": { "dependsOn": ["^lint"] },
		"type-check": { "dependsOn": ["^type-check"] }
	}
}
