{
	"ui": "tui",
	"$schema": "https://turbo.build/schema.json",

	"globalEnv": ["NODE_*", "VITE_*"],
	"globalDependencies": ["bun.lock", ".oxfmtrc.json", ".oxlintrc.json", "tsconfig.json"],

	"tasks": {
		"dev:client": {"cache": false, "persistent": true},
		"dev:server": {"cache": false, "persistent": true},

		"build:client": {"dependsOn": ["^check"], "outputs": ["dist/**"]},
		"build:server": {"dependsOn": ["^check"], "outputs": ["dist/**"]},

		"test": {"dependsOn": ["^test"]},
		"fix": {"dependsOn": ["^fix"]},
		"check": {"dependsOn": ["fix", "^check"]}
	}
}
