{
	"$schema": "node_modules/@biomejs/biome/configuration_schema.json",

	"plugins": [
		"./packages/linter/src/no-type-assertion.grit",
		"./packages/linter/src/no-renamed-imports.grit",
		"./packages/linter/src/no-return-undefined-null.grit",
		"./packages/linter/src/no-native-methods.grit",
		"./packages/linter/src/no-effect-antipatterns.grit",
		"./packages/linter/src/no-pipe-method.grit",
		"./packages/linter/src/no-arg-destructuring.grit",
		"./packages/linter/src/no-access-variables.grit",
		"./packages/linter/src/no-simple-check-variables.grit",
		"./packages/linter/src/no-react-type-imports.grit",
		"./packages/linter/src/no-react-hooks.grit",
		"./packages/linter/src/cn-classname.grit",
		"./packages/linter/src/no-arrow-for-named.grit",
		"./packages/linter/src/no-ternary-in-jsx.grit",
		"./packages/linter/src/no-variable-type-annotation.grit",
		"./packages/linter/src/no-return-type-annotation.grit",
		"./packages/linter/src/no-tailwind-class-variables.grit",
		"./packages/linter/src/no-simple-function-variables.grit",
		"./packages/linter/src/no-primitive-const.grit",
		"./packages/linter/src/no-length-check.grit",
		"./packages/linter/src/no-typeof.grit",
		"./packages/linter/src/no-in-operator.grit",
		"./packages/linter/src/no-nullish-checks.grit",
		"./packages/linter/src/no-dynamic-imports.grit",
		"./packages/linter/src/no-else.grit"
	],

	"linter": {
		"domains": { "react": "recommended" },
		"rules": {
			"complexity": {
				"useLiteralKeys": "off",
				"useArrowFunction": "off",
				"noUselessUndefined": "error",
				"noUselessStringConcat": "error",
				"useSimplifiedLogicExpression": "error"
			},
			"suspicious": {
				"noConsole": "error",
				"noExplicitAny": "error",
				"noArrayIndexKey": "off",
				"noConfusingVoidType": "off",
				"noAssignInExpressions": "off",
				"noShadowRestrictedNames": "off",
				"useIterableCallbackReturn": "off"
			},
			"style": {
				"useExportType": "error",
				"noUselessElse": "error",
				"noNestedTernary": "error",
				"useNumberNamespace": "warn",
				"noNonNullAssertion": "error",
				"useCollapsedElseIf": "error",
				"useAsConstAssertion": "warn",
				"useEnumInitializers": "warn",
				"noParameterProperties": "error",
				"useDefaultParameterLast": "warn",
				"useConsistentTypeDefinitions": { "level": "error", "options": { "style": "type" } },
				"noUnusedTemplateLiteral": "error",
				"useImportType": { "level": "error", "options": { "style": "separatedType" } },
				"useConsistentArrayType": { "level": "error", "options": { "syntax": "shorthand" } },
				"noParameterAssign": { "level": "error", "options": { "propertyAssignment": "deny" } },
				"noRestrictedGlobals": {
					"level": "error",
					"options": {
						"deniedGlobals": {
							"global": "",
							"globalThis": "",
							"location": "Use Tanstack router",
							"Array": "Import Array from 'effect' instead",
							"Option": "Import Option from 'effect' instead",
							"Number": "Import Number from 'effect' instead",
							"String": "Import String from 'effect' instead",
							"Object": "Import Record from 'effect' instead",
							"Boolean": "Import Boolean from 'effect' instead"
						}
					}
				}
			},
			"correctness": {
				"useYield": "off",
				"noChildrenProp": "off",
				"noUnusedImports": "off",
				"noUnusedVariables": "off",
				"useHookAtTopLevel": "error",
				"useImportExtensions": "error",
				"noUndeclaredDependencies": "off",
				"noUnusedFunctionParameters": "off"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"useSortedClasses": { "level": "error", "fix": "safe" }
			}
		}
	},

	"formatter": { "lineWidth": 120, "formatWithErrors": true },
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							["side-effect", "side-effect-style"],
							":BLANK_LINE:",
							[":NODE:"],
							":BLANK_LINE:",
							["@effect/**"],
							["effect"],
							":BLANK_LINE:",
							[":PACKAGE:"],
							":BLANK_LINE:",
							["@ai-toolkit/**"],
							":BLANK_LINE:",
							["@/", "#", "~"],
							":BLANK_LINE:",
							["../"],
							["./"]
						]
					}
				}
			}
		}
	},

	"html": { "formatter": { "indentScriptAndStyle": true } },
	"css": {
		"formatter": { "enabled": true },
		"parser": { "cssModules": true, "tailwindDirectives": true }
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"bracketSpacing": false,
			"semicolons": "asNeeded",
			"trailingCommas": "none",
			"arrowParentheses": "asNeeded"
		}
	},

	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.tsx",
			"**/*.css",
			"**/*.html",
			"**/*.grit",
			"**/*.json",
			"**/*.jsonc",
			"!**/*.gen.ts",
			"!**/routeTree.gen.ts"
		]
	},

	"overrides": [
		{
			"includes": ["**/package.json"],
			"json": { "formatter": { "expand": "auto" } }
		},
		{
			"includes": ["**/components/ui/**"],
			"linter": { "enabled": false }
		}
	]
}
