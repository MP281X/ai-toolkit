{
	"type": "module",
	"sideEffects": false,
	"name": "@deslop/template-app",

	"version": "0.0.0",
	"files": ["dist"],
	"publishConfig": {"access": "public"},
	"bin": {"template-app": "dist/server.js"},
	"repository": {"type": "git", "url": "https://github.com/MP281X/deslop"},

	"imports": {
		"#lib/*": "./src/lib/*",
		"#rpcs/*": "./src/rpcs/*",
		"#routes/*": "./src/routes/*"
	},

	"scripts": {
		"dev": "vp dev --host 0.0.0.0",

		"build": "rm -rf dist && vp build && vp pack",

		"preview": "vp run build && node --env-file-if-exists=.env ./dist/server.js"
	},

	"devDependencies": {
		"react": "^19",
		"react-dom": "^19",

		"@tanstack/react-router": "latest",

		"@deslop/runtime": "workspace:*",
		"@deslop/components": "workspace:*"
	}
}
