{
	"type": "module",
	"sideEffects": false,
	"name": "@ai-toolkit/ai",

	"imports": {
		"#lib/*": "./src/lib/*",
		"#tools/*": "./src/tools/*",
		"#codegen/*": "./codegen/*"
	},

	"exports": {
		"./service": "./src/service.ts",
		"./schema": "./src/schema.ts",
		"./tools": "./src/tools/contracts.ts",
		"./utils": "./src/lib/utils.ts",
		"./catalog": "./src/catalog.ts"
	},

	"scripts": {
		"codegen:codex-app-server": "bun run codegen/codex-app-server.ts",

		"test": "bun test --concurrent",
		"fix": "(oxlint --fix --fix-suggestions . || true) && oxfmt .",
		"check": "oxfmt --check . && oxlint ."
	},

	"dependencies": {
		"exa-js": "latest",

		"@effect/ai-openai": "^4.0.0-beta",
		"@effect/ai-anthropic": "^4.0.0-beta",
		"@effect/ai-openrouter": "^4.0.0-beta",
		"@effect/ai-openai-compat": "^4.0.0-beta"
	}
}
