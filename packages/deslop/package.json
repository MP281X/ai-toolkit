{
	"type": "module",
	"sideEffects": false,
	"name": "@ai-toolkit/deslop",

	"bin": {
		"deslop": "./src/index.ts"
	},

	"imports": {
		"#lib/*": "./src/lib/*",
		"#rules/*": "./src/rules/*"
	},

	"scripts": {
		"build": "bun build --target=bun ./src/index.ts --outfile ./dist/deslop.js",

		"test": "bun test --concurrent",
		"fix": "oxlint --fix-dangerously --silent . || true; oxfmt . || true",
		"check": "oxfmt --check . && oxlint ."
	}
}
