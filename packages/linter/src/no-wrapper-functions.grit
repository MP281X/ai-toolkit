engine biome(1.0)
language js(typescript, jsx)

`function $name($params) { return $expr }` as $match where {
	$expr <: or {
		`$callee($_)` where { not $callee <: `pipe` },
		`new $_($_)`
	},
	register_diagnostic(span=$match, message="Don't create wrapper functions that only delegate to another call. Inline them first; these wrappers add indirection and often create the exact type and inference problems you are trying to patch")
}
