engine biome(1.0)
language js(typescript, jsx)

or {
	`function $name($params) { $_ }`,
	`function $name($params): $_ { $_ }`,
	`function ($params) { $_ }`,
	`function ($params): $_ { $_ }`,
	`function* $name($params) { $_ }`,
	`function* $name($params): $_ { $_ }`,
	`function* ($params) { $_ }`,
	`function* ($params): $_ { $_ }`,
	`async function $name($params) { $_ }`,
	`async function $name($params): $_ { $_ }`,
	`async function ($params) { $_ }`,
	`async function ($params): $_ { $_ }`,
	`async function* $name($params) { $_ }`,
	`async function* $name($params): $_ { $_ }`,
	`async function* ($params) { $_ }`,
	`async function* ($params): $_ { $_ }`,
	`($params) => $_`,
	`($params): $_ => $_`,
	`async ($params) => $_`,
	`async ($params): $_ => $_`
} where {
	or {
		$params <: contains `{ $_ }` as $destructured where {
			register_diagnostic(span=$destructured, message="Don't destructure function parameters. Keep the original parameter object and access `param.prop` inside the body so the data source stays visible")
		},
		$params <: contains `{ $first, $second }` as $destructured where {
			register_diagnostic(span=$destructured, message="Don't destructure function parameters. Keep the original parameter object and access `param.prop` inside the body so the data source stays visible")
		},
		$params <: contains `{ $first, $second, $third }` as $destructured where {
			register_diagnostic(span=$destructured, message="Don't destructure function parameters. Keep the original parameter object and access `param.prop` inside the body so the data source stays visible")
		},
		$params <: contains `{ $first, $second, $third, $fourth }` as $destructured where {
			register_diagnostic(span=$destructured, message="Don't destructure function parameters. Keep the original parameter object and access `param.prop` inside the body so the data source stays visible")
		},
		$params <: contains `{ $first, $second, $third, $fourth, $fifth }` as $destructured where {
			register_diagnostic(span=$destructured, message="Don't destructure function parameters. Keep the original parameter object and access `param.prop` inside the body so the data source stays visible")
		}
	}
}
