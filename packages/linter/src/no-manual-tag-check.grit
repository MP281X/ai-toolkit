engine biome(1.0)
language js(typescript, jsx)

`$expr._tag === $tag` as $match where {
	register_diagnostic(span=$match, message="Do not manually inspect `_tag`. Use the helper for the actual ADT instead: `Option.isSome/isNone` for Option, `Match.is(...)` for tagged unions, or `Predicate.isTagged(...)` for custom tagged values. This is the idiomatic and usually safer narrowing")
}
