engine biome(1.0)
language js(typescript, jsx)

or {
	`import type { $_ } from 'react'`,
	`import type { $_ } from "react"`,
	`import type * as $_ from 'react'`,
	`import type * as $_ from "react"`,
	`import * as $_ from 'react'`,
	`import * as $_ from "react"`
} as $match where {
	register_diagnostic(span=$match, message="Do not import React namespace from `react`. Named imports are preferred; use `import {useState} from 'react'` or use global `React.ReactNode`, `React.FC` directly")
}
