engine biome(1.0)
language js(typescript, jsx)

`const $name = $expr` as $match where {
	$expr <: or {
		`$_ === $_`,
		`$_ !== $_`,
		`$_ > $_`,
		`$_ < $_`,
		`$_ >= $_`,
		`$_ <= $_`,
		`!$_`
	},
	register_diagnostic(span=$match, message="Inline the check. Extracting booleans detaches narrowing from the branch.")
}
