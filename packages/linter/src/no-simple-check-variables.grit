engine biome(1.0)
language js(typescript, jsx)

`const $name = $expr` as $match where {
	$expr <: or {
		`$_ === $_`,
		`$_ !== $_`,
		`$_ > $_`,
		`$_ < $_`,
		`$_ >= $_`,
		`$_ <= $_`,
		`!$_`
	},
	register_diagnostic(span=$match, message="Don't extract simple boolean checks into variables. Inline the condition at the branch or use site so the logic stays local and the narrowing stays attached to the check")
}
