engine biome(1.0)
language js(typescript, jsx)

`const $name = $expr` as $match where {
	$expr <: or {
		`$_ === $_`,
		`$_ !== $_`,
		`$_ > $_`,
		`$_ < $_`,
		`$_ >= $_`,
		`$_ <= $_`,
		`!$_`
	},
	register_diagnostic(span=$match, message="Do not extract a trivial boolean check into a variable. Inline the comparison inside the branch that uses it so narrowing and control flow stay attached.")
}
