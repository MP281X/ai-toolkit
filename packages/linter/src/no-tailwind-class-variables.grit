engine biome(1.0)
language js(typescript, jsx)

`const $name = $value` as $match where {
	$value <: r"['\"].*?(?:border-|bg-|text-|p-|m-).*['\"]",
	register_diagnostic(span=$match, message="Don't store Tailwind class strings in variables. Inline them at the use site so Tailwind can see them, and use `cn()` for conditional classes")
}
