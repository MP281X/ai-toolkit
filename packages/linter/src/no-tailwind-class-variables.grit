engine biome(1.0)
language js(typescript, jsx)

or {
	`const $name = $value` as $match where {
		$value <: r"['\"].*?(?:bg-|border-|rounded-|shadow|ring-|backdrop-|hover:bg-|hover:border-|hover:text-|focus:bg-|focus:border-|focus:text-|dark:bg-|dark:border-|dark:text-).*['\"]",
		not $filename <: r".*/components/ui/.*",
		register_diagnostic(span=$match, message="Do not store Tailwind class tokens outside `className` or `className={cn(...)}`. Inline the classes at the JSX use site so styling stays local and Tailwind can see the final class names directly.")
	},
	`$key: $value` as $match where {
		$value <: r"['\"].*?(?:bg-|border-|rounded-|shadow|ring-|backdrop-|hover:bg-|hover:border-|hover:text-|focus:bg-|focus:border-|focus:text-|dark:bg-|dark:border-|dark:text-).*['\"]",
		not $filename <: r".*/components/ui/.*",
		register_diagnostic(span=$match, message="Do not store Tailwind class tokens in objects or config maps. Move the classes directly into `className` or `className={cn(...)}` so styling stays local and agents cannot build invalid style configuration layers.")
	},
	`cva($...)` as $match where {
		not $filename <: r".*/components/ui/.*",
		register_diagnostic(span=$match, message="Do not use `cva(...)` outside `components/ui`. Tailwind class tokens may only live directly in `className` or `className={cn(...)}` at the JSX use site in regular app code.")
	}
}
