engine biome(1.0)
language js(typescript, jsx)

or {
	`const $name: $type = $expr`,
	`let $name: $type = $expr`
} as $match where {
	not $filename <: r".*/components/ui/.*",
	register_diagnostic(span=$match, message="Don't add explicit variable type annotations in implementation code. They add noise, reduce inference, and often coerce wrong code into compiling instead of fixing the real problem. Rewrite the code so TypeScript infers the type naturally. For empty containers, use typed factories like `Array.empty<T>()` or `Record.empty<K, V>()`")
}
