engine biome(1.0)
language js(typescript, jsx)

or {
	`const $name: $type = $expr`,
	`let $name: $type = $expr`
} as $match where {
	not $filename <: r".*/components/ui/.*",
	register_diagnostic(span=$match, message="Remove type annotation. Rewrite until inference works. For empty containers: `Array.empty<T>()`, `Record.empty<K, V>()`.")
}
