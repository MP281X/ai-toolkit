engine biome(1.0)
language js(typescript, jsx)

or {
	`const $name = ($args) => $body`,
	`export const $name = ($args) => $body`,
	`const $name = function ($args) { $body }`,
	`export const $name = function ($args) { $body }`,
	`const $name = function $fnName($args) { $body }`,
	`export const $name = function $fnName($args) { $body }`
} as $match where {
	register_diagnostic(span=$match, message="Use a function declaration for named functions. Reserve arrow functions for inline callbacks only; this keeps code consistent and easier to lint")
}
