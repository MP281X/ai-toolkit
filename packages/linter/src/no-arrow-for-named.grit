engine biome(1.0)
language js(typescript, jsx)

or {
	`export const $name = ($args) => $body`,
	`const $name = ($args) => { $body }`,
	`export const $name = ($args) => { $body }`,
	`const $name = function ($args) { $body }`,
	`export const $name = function ($args) { $body }`,
	`const $name = function $fnName($args) { $body }`,
	`export const $name = function $fnName($args) { $body }`
} as $match where {
	not $match <: or {
		`const $_ = ($_) => { return $_; }`,
		`const $_ = function ($_) { return $_; }`,
		`const $_ = function $_($_) { return $_; }`
	},
	register_diagnostic(span=$match, message="Rewrite this as `function name(...) { ... }`. Named reusable functions should use function declarations; variable-assigned functions create inconsistent shapes and conflict with inlining rules.")
}
