engine biome(1.0)
language js(typescript, jsx)

or {
	or {
		`$expr.length === 0`,
		`$expr.length == 0`,
		`$expr.length < 1`,
		`0 === $expr.length`,
		`0 == $expr.length`
	} as $match where {
		register_diagnostic(span=$match, message="Do not write manual empty checks with `.length`. Use the correct helper instead: `String.isEmpty`, `Array.isArrayEmpty`, or `Array.isReadonlyArrayEmpty`")
	},
	or {
		`$expr.length > 0`,
		`$expr.length >= 1`,
		`$expr.length !== 0`,
		`$expr.length != 0`,
		`0 < $expr.length`,
		`1 <= $expr.length`
	} as $match where {
		register_diagnostic(span=$match, message="Do not write manual non-empty checks with `.length`. Use the correct helper instead: `String.isNonEmpty`, `Array.isArrayNonEmpty`, or `Array.isReadonlyArrayNonEmpty`")
	}
}
