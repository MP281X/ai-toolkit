engine biome(1.0)
language js(typescript, jsx)

or {
	or {
		`$expr.length === 0`,
		`$expr.length == 0`,
		`$expr.length < 1`,
		`0 === $expr.length`,
		`0 == $expr.length`
	} as $match where {
		register_diagnostic(span=$match, message="Do not write manual empty checks with `.length`. Replace this with the matching helper such as `String.isEmpty(value)`, `Array.isArrayEmpty(value)`, or `Array.isReadonlyArrayEmpty(value)` so the intent is explicit and consistent.")
	},
	or {
		`$expr.length > 0`,
		`$expr.length >= 1`,
		`$expr.length !== 0`,
		`$expr.length != 0`,
		`0 < $expr.length`,
		`1 <= $expr.length`
	} as $match where {
		register_diagnostic(span=$match, message="Do not write manual non-empty checks with `.length`. Replace this with the matching helper such as `String.isNonEmpty(value)`, `Array.isArrayNonEmpty(value)`, or `Array.isReadonlyArrayNonEmpty(value)` so the intent is explicit and consistent.")
	}
}
