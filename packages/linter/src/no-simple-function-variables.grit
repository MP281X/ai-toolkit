engine biome(1.0)
language js(typescript, jsx)

or {
	`const $name = function ($params) { return $expr; }` as $match where {
		register_diagnostic(span=$match, message="Don't extract simple functions. Inline the expression at the use site; simple helper extraction adds indirection and often weakens inference")
	},
	`const $name = function $fnName($params) { return $expr; }` as $match where {
		register_diagnostic(span=$match, message="Don't extract simple functions. Inline the expression at the use site; simple helper extraction adds indirection and often weakens inference")
	},
	`const $name = ($params) => $expr` as $match where {
		not $expr <: contains `{$_}`,
		register_diagnostic(span=$match, message="Don't extract simple functions. Inline the expression at the use site; simple helper extraction adds indirection and often weakens inference")
	}
}
