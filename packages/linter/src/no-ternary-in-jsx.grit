engine biome(1.0)
language js(typescript, jsx)

`$cond ? $a : $b` as $match where {
	$b <: or {
		`null`,
		`undefined`
	},
	$a <: contains or {
		`<$_>$_</$_>`,
		`<$_ />`,
		`<>$_</>`
	},
	register_diagnostic(span=$match, message="When the false branch is empty, use `$cond && <...>` instead of a ternary with `null` or `undefined`; logical AND is the cleaner conditional rendering pattern")
}
