engine biome(1.0)
language js(typescript, jsx)

or {
	`$expr == null` as $match where { register_diagnostic(span=$match, message="Use `Predicate.isNullish(x)`.") },
	`$expr != null` as $match where { register_diagnostic(span=$match, message="Use `Predicate.isNotNullish(x)`.") },
	`$expr === null` as $match where { register_diagnostic(span=$match, message="Use `Predicate.isNull(x)`.") },
	`$expr !== null` as $match where { register_diagnostic(span=$match, message="Use `Predicate.isNotNull(x)`.") },
	`$expr === undefined` as $match where { register_diagnostic(span=$match, message="Use `Predicate.isUndefined(x)`.") },
	`$expr !== undefined` as $match where {
		register_diagnostic(span=$match, message="Use `Predicate.isNotUndefined(x)`.")
	}
}
