engine biome(1.0)
language js(typescript, jsx)

or {
	`const $name = $obj.$prop` as $match where {
		not $obj <: contains `$_($...)`,
		register_diagnostic(span=$match, message="Do not store a property access in a local alias. Inline the access where it is used so the data source stays visible and the extra name does not hide trivial code.")
	},
	`const $name = $var` as $match where {
		$var <: r"[a-zA-Z_$][a-zA-Z0-9_$]*",
		not $var <: or {
			`$_.$_`,
			`$_($...)`,
			`true`,
			`false`,
			`null`,
			`undefined`
		},
		register_diagnostic(span=$match, message="Do not copy a value into a same-level alias. Keep using the original name so the code stays direct and the extra binding does not hide trivial data flow.")
	},
	`const $name = { ...$var }` as $match where {
		register_diagnostic(span=$match, message="Do not clone a value into a same-level alias with object spread. Keep using the original name so the code stays direct and the extra binding does not hide trivial data flow.")
	}
}
