engine biome(1.0)
language js(typescript, jsx)

or {
	`$fn($...)` as $match where {
		$fn <: or {
			`useState` where {
				$match <: `useState(() => $value)`,
				register_diagnostic(span=$fn, message="Do not use lazy `useState` initializers here. React Compiler already handles memoization, so inline the value or create it directly instead of hiding it behind state initialization.")
			},
			`useCallback` where {
				register_diagnostic(span=$fn, message="Do not use `useCallback` here. React Compiler already handles this memoization, so remove the wrapper and keep the inline callback unless you are integrating with an external API that truly requires a stable function identity.")
			},
			`useMemo` where {
				register_diagnostic(span=$fn, message="Do not use `useMemo` here. React Compiler already handles this memoization, so inline the computation or keep it as plain code unless you are working around an external API boundary.")
			},
			`memo` where {
				register_diagnostic(span=$fn, message="Do not wrap components with `memo` here. React Compiler already handles this optimization, so export the component directly unless you have a proven external interoperability reason.")
			},
			`forwardRef` where {
				register_diagnostic(span=$fn, message="Do not use `forwardRef` here. In React 19, accept `ref` as a regular prop directly on the component instead of wrapping it with legacy ref plumbing.")
			}
		}
	},
	`$fn<$_>($...)` as $match where {
		$fn <: or {
			`useState` where {
				$match <: `useState<$_>(() => $value)`,
				register_diagnostic(span=$fn, message="Do not use lazy `useState` initializers here. React Compiler already handles memoization, so inline the value or create it directly instead of hiding it behind state initialization.")
			},
			`useCallback` where {
				register_diagnostic(span=$fn, message="Do not use `useCallback` here. React Compiler already handles this memoization, so remove the wrapper and keep the inline callback unless you are integrating with an external API that truly requires a stable function identity.")
			},
			`useMemo` where {
				register_diagnostic(span=$fn, message="Do not use `useMemo` here. React Compiler already handles this memoization, so inline the computation or keep it as plain code unless you are working around an external API boundary.")
			},
			`memo` where {
				register_diagnostic(span=$fn, message="Do not wrap components with `memo` here. React Compiler already handles this optimization, so export the component directly unless you have a proven external interoperability reason.")
			},
			`forwardRef` where {
				register_diagnostic(span=$fn, message="Do not use `forwardRef` here. In React 19, accept `ref` as a regular prop directly on the component instead of wrapping it with legacy ref plumbing.")
			}
		}
	}
}
