engine biome(1.0)
language js(typescript, jsx)

`$obj.$method($...)` as $match where {
	$method <: or {
		`map`,
		`filter`,
		`reduce`,
		`reduceRight`,
		`find`,
		`findIndex`,
		`findLast`,
		`findLastIndex`,
		`some`,
		`every`,
		`forEach`,
		`flatMap`,
		`flat`,
		`trim`,
		`trimStart`,
		`trimEnd`,
		`toUpperCase`,
		`toLowerCase`,
		`split`,
		`slice`,
		`substring`,
		`startsWith`,
		`endsWith`,
		`includes`,
		`indexOf`,
		`lastIndexOf`,
		`replace`,
		`replaceAll`,
		`match`,
		`matchAll`,
		`search`,
		`repeat`,
		`padStart`,
		`padEnd`,
		`at`,
		`concat`,
		`charAt`,
		`charCodeAt`,
		`codePointAt`,
		`normalize`
	},
	not $obj <: or {
		`Effect`,
		`Stream`,
		`Layer`,
		`Record`,
		`Option`,
		`Either`,
		`Exit`,
		`Fiber`,
		`Chunk`,
		`Schedule`,
		`Duration`,
		`Cause`,
		`Match`,
		`Schema`,
		`Array`,
		`String`,
		`SchemaTransformation`
	},
	register_diagnostic(span=$match, message="Do not use native prototype methods here. Replace them with the matching Effect module helper such as `Array.*`, `String.*`, or `Record.*` so collection and string logic stays explicit, composable, and consistent.")
}
