engine biome(1.0)
language js(typescript, jsx)

or {
	`Effect.fail($_)` as $match where {
		register_diagnostic(span=$match, message="Do not wrap domain errors with `Effect.fail(...)` here. In `Effect.gen` or `Effect.fnUntraced`, yield the tagged error directly with `yield* new DomainError(...)` so the error stays in the typed control flow instead of being manually re-wrapped.")
	},
	`function $name($args) { return Effect.gen($body); }` as $match where {
		register_diagnostic(span=$match, message="Do not wrap `Effect.gen(...)` in a named function declaration. Rewrite argument-taking effects as `Effect.fnUntraced(function* (value) { ... })` so the function shape matches the repo pattern and keeps effect code reusable without extra wrappers.")
	},
	`($args) => Effect.gen($body)` as $match where {
		register_diagnostic(span=$match, message="Do not wrap `Effect.gen(...)` in an arrow function. Rewrite argument-taking effects as `Effect.fnUntraced(function* (value) { ... })` so the function shape matches the repo pattern and keeps effect code reusable without extra wrappers.")
	}
}
