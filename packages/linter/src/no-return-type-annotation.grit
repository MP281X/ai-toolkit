engine biome(1.0)
language js(typescript, jsx)

or {
	// Named function declarations
	`function $name($params): $type { $body }`,
	`function $name($params): $type;`,
	// Arrow functions assigned to const
	`const $name = ($params): $type => $body`,
	// Function expressions assigned to const
	`const $name = function ($params): $type { $body }`,
	// Callback arrow functions (as arguments)
	`($params): $type => $body`,
	// Callback function expressions (as arguments)
	`function ($params): $type { $body }`
} as $match where {
	register_diagnostic(span=$match, message="Remove return type annotation. Rewrite until inference works.")
}
