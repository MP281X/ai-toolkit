engine biome(1.0)
language js(typescript, jsx)

`const $name = $value` as $match where {
	$value <: or {
		string(),
		number(),
		`true`,
		`false`,
		`$n as const` where $n <: or {
			string(),
			number(),
			`true`,
			`false`
		}
	},
	not $value <: or {
		r"['\"].*?(?:border-|bg-|text-|p-|m-).*['\"]",
		`$tailwind as const` where $tailwind <: r"['\"].*?(?:border-|bg-|text-|p-|m-).*['\"]"
	},
	register_diagnostic(span=$match, message="Do not extract primitive literals into standalone constants. Inline the value at the use site so the code stays direct and reviewers do not have to jump through fake config names.")
}
