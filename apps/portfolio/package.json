{
	"type": "module",
	"sideEffects": false,
	"name": "@deslop/portfolio",

	"imports": {
		"#lib/*": "./src/lib/*",
		"#rpcs/*": "./src/rpcs/*",
		"#routes/*": "./src/routes/*"
	},

	"scripts": {
		"dev": "NODE_ENV=development PORT=3000 node ./src/main.server.ts",
		"build": "vp build && vp pack",

		"preview": "vp run build && NODE_ENV=production PORT=4000 node ./dist/server.js"
	},

	"devDependencies": {
		"react": "^19",
		"react-dom": "^19",

		"@tanstack/react-router": "latest",
		"@tanstack/router-plugin": "latest",
		"@tanstack/react-hotkeys": "latest",

		"@deslop/server": "workspace:*",
    "@deslop/components": "workspace:*",
    "@deslop/opentelemetry": "workspace:*",

		"@vitejs/plugin-react": "latest",
		"@rolldown/plugin-babel": "latest",
		"babel-plugin-react-compiler": "latest",

		"tailwindcss": "latest",
		"@tailwindcss/vite": "latest"
	}
}
