{
	"type": "module",
	"sideEffects": false,
	"name": "@deslop/portfolio",

	"imports": {
		"#lib/*": "./src/lib/*",
		"#rpcs/*": "./src/rpcs/*",
		"#routes/*": "./src/routes/*"
	},

	"scripts": {
		"dev": "vp dev --host 0.0.0.0",

		"build": "rm -rf dist && vp build && vp pack",

		"preview": "vp run build && node --env-file-if-exists=.env ./dist/server.js"
	},

	"devDependencies": {
		"react": "^19",
		"react-dom": "^19",

		"@tanstack/react-router": "latest",
		"@tanstack/react-hotkeys": "latest",

		"@deslop/components": "workspace:*",
		"@deslop/opentelemetry": "workspace:*",
		"@deslop/vite": "workspace:*"
	}
}
