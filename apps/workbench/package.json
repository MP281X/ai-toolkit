{
	"type": "module",
	"sideEffects": false,
	"name": "@deslop/workbench",

	"version": "0.0.0",
	"files": ["dist"],
	"publishConfig": {"access": "public"},
	"bin": {"workbench": "dist/server.js"},
	"repository": {"type": "git", "url": "https://github.com/MP281X/deslop"},

	"imports": {
		"#lib/*": "./src/lib/*",
		"#rpcs/*": "./src/rpcs/*",
		"#routes/*": "./src/routes/*"
	},

	"scripts": {
		"dev:client": "vp dev",
		"dev:server": "node --inspect=127.0.0.1:0 --watch ./src/main.server.ts",

		"build": "rm -rf dist && vp build && vp pack",

		"preview": "vp run build && PORT=7010 node ./dist/server.js"
	},

	"dependencies": {
		"@deslop/terminal": "workspace:*"
	},

	"devDependencies": {
		"react": "^19",
		"react-dom": "^19",

		"@tanstack/react-router": "latest",
		"@tanstack/router-plugin": "latest",
		"@tanstack/react-hotkeys": "latest",

		"@deslop/ai": "workspace:*",
		"@deslop/agent-browser": "workspace:*",
		"@deslop/git": "workspace:*",
		"@deslop/portless": "workspace:*",
		"@deslop/usage": "workspace:*",
		"@deslop/components": "workspace:*",
		"@deslop/opentelemetry": "workspace:*",

		"@vitejs/plugin-react": "latest",
		"@rolldown/plugin-babel": "latest",
		"babel-plugin-react-compiler": "latest",

		"tailwindcss": "latest",
		"@tailwindcss/vite": "latest"
	}
}
