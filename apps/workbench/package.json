{
	"type": "module",
	"sideEffects": false,
	"name": "@deslop/workbench",

	"version": "0.0.0",
	"files": ["dist"],
	"publishConfig": {"access": "public"},
	"bin": {"workbench": "dist/server.js"},
	"repository": {"type": "git", "url": "https://github.com/MP281X/deslop"},

	"imports": {
		"#lib/*": "./src/lib/*",
		"#rpcs/*": "./src/rpcs/*",
		"#routes/*": "./src/routes/*"
	},

	"scripts": {
		"dev": "vp dev --host 0.0.0.0",

		"build": "rm -rf dist && vp build && vp pack",

		"preview": "vp run build && node --env-file-if-exists=.env ./dist/server.js"
	},

	"dependencies": {
		"@lydell/node-pty": "latest"
	},

	"devDependencies": {
		"react": "^19",
		"react-dom": "^19",

		"@tanstack/react-router": "latest",
		"@tanstack/react-hotkeys": "latest",

		"@deslop/ai": "workspace:*",
		"@deslop/agent": "workspace:*",
		"@deslop/agent-browser": "workspace:*",
		"@deslop/git": "workspace:*",
		"@deslop/portless": "workspace:*",
		"@deslop/scripts": "workspace:*",
		"@deslop/os": "workspace:*",
		"@deslop/terminal": "workspace:*",
		"@deslop/components": "workspace:*",
		"@deslop/opentelemetry": "workspace:*",
		"@deslop/vite": "workspace:*"
	}
}
