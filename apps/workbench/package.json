{
	"type": "module",
	"sideEffects": false,
	"name": "@deslop/workbench",

	"version": "0.0.0",
	"files": ["dist"],
	"publishConfig": {"access": "public"},
	"bin": {"workbench": "dist/server.js"},
	"repository": {"type": "git", "url": "https://github.com/MP281X/deslop"},
	"exports": {
		"./code-mode": "./dist/code-mode.js"
	},

	"imports": {
		"#lib/*": "./src/lib/*",
		"#rpcs/*": "./src/rpcs/*",
		"#routes/*": "./src/routes/*",
		"#services/*": "./src/services/*"
	},

	"scripts": {
		"dev": "vp dev --host 0.0.0.0",

		"build": "rm -rf dist && vp build && vp pack",

		"preview": "vp run build && PORT=7010 node --env-file-if-exists=.env ./dist/server.js"
	},

	"dependencies": {
		"diff": "latest"
	},

	"devDependencies": {
		"react": "^19",
		"react-dom": "^19",

		"@tanstack/react-router": "latest",
		"@tanstack/react-hotkeys": "latest",

		"@deslop/agent": "workspace:*",
		"@deslop/file-storage": "workspace:*",
		"@deslop/git": "workspace:*",
		"@deslop/oauth": "workspace:*",
		"@deslop/process": "workspace:*",
		"@deslop/components": "workspace:*",
		"@deslop/opentelemetry": "workspace:*",
		"@deslop/vite": "workspace:*"
	}
}
