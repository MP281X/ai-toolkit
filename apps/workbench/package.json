{
	"type": "module",
	"sideEffects": false,
	"name": "@deslop/workbench",

	"version": "0.0.0",
	"files": ["dist"],
	"publishConfig": {"access": "public"},
	"bin": {"workbench": "dist/workbench"},
  "repository": {"type": "git", "url": "https://github.com/MP281X/deslop"},

	"imports": {
		"#lib/*": "./src/lib/*",
		"#rpcs/*": "./src/rpcs/*",
		"#routes/*": "./src/routes/*"
	},

	"scripts": {
		"dev:client": "vp dev --port 3020",
		"dev:server": "bun --watch --port 3021 ./src/main.server.tsx",

		"build:client": "vp build",
		"build:server": "bun build ./src/main.server.tsx --production --target=bun --compile --outfile ./dist/workbench"
	},

	"devDependencies": {
		"react": "^19",
		"react-dom": "^19",

		"@tanstack/react-router": "latest",
		"@tanstack/router-plugin": "latest",
		"@tanstack/react-hotkeys": "latest",

		"@deslop/git": "workspace:*",
		"@deslop/browser": "workspace:*",
		"@deslop/terminal": "workspace:*",
		"@deslop/components": "workspace:*",
		"@deslop/opentelemetry": "workspace:*",

		"@vitejs/plugin-react": "latest",
		"@rolldown/plugin-babel": "latest",
		"babel-plugin-react-compiler": "latest",

		"tailwindcss": "latest",
		"@tailwindcss/vite": "latest"
	}
}
