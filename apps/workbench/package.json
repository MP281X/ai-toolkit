{
	"type": "module",
	"sideEffects": false,
	"name": "@deslop/workbench",

	"version": "0.0.0",
	"files": ["dist"],
	"publishConfig": {"access": "public"},
	"bin": {"workbench": "dist/server.js"},
	"repository": {"type": "git", "url": "https://github.com/MP281X/deslop"},

	"imports": {
		"#lib/*": "./src/lib/*",
		"#rpcs/*": "./src/rpcs/*",
		"#routes/*": "./src/routes/*"
	},

	"scripts": {
		"dev": "NODE_ENV=development PORT=3010 node ./src/main.server.ts",
		"build": "vp build && vp pack",

		"preview": "vp run build && NODE_ENV=production PORT=4010 node ./dist/server.js"
	},

	"devDependencies": {
		"react": "^19",
		"react-dom": "^19",

		"@tanstack/react-router": "latest",
		"@tanstack/router-plugin": "latest",
		"@tanstack/react-hotkeys": "latest",

		"@deslop/git": "workspace:*",
    "@deslop/server": "workspace:*",
		"@deslop/browser": "workspace:*",
		"@deslop/terminal": "workspace:*",
		"@deslop/components": "workspace:*",
		"@deslop/opentelemetry": "workspace:*",

		"@vitejs/plugin-react": "latest",
		"@rolldown/plugin-babel": "latest",
		"babel-plugin-react-compiler": "latest",

		"tailwindcss": "latest",
		"@tailwindcss/vite": "latest"
	}
}
