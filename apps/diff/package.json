{
	"type": "module",
	"sideEffects": false,
	"name": "@ai-toolkit/diff",

	"imports": {
		"#lib/*": "./src/lib/*",
		"#rpcs/*": "./src/rpcs/*",
		"#routes/*": "./src/routes/*"
	},

	"scripts": {
		"dev:client": "vite dev --port 3010",
		"dev:server": "bun --watch --port 3011 ./src/main.server.tsx",

		"build:client": "vite build",
		"build:server": "bun build ./src/main.server.tsx --target=bun --outfile ./dist/server.js",

		"fix": "biome check --write --unsafe",
		"check": "biome check && tsgo --noEmit && effect-language-service diagnostics --project ./tsconfig.json"
	},

	"dependencies": {
		"react": "^19",
		"react-dom": "^19",
		"@tanstack/react-router": "latest",
		"@tanstack/router-plugin": "latest",

		"@ai-toolkit/git": "workspace:*",
		"@ai-toolkit/components": "workspace:*",
		"@ai-toolkit/opentelemetry": "workspace:*"
	},

	"devDependencies": {
		"vite": "latest",
		"@vitejs/plugin-react": "latest",
		"@rolldown/plugin-babel": "latest",
		"babel-plugin-react-compiler": "latest",

		"tailwindcss": "latest",
		"@tailwindcss/vite": "latest"
	}
}
