{
	"$schema": "https://opencode.ai/config.json",
	"default_agent": "orchestrator",
	"agents": {
		"build": {"model": "openai/gpt-5.6-sol#medium", "hidden": true},
		"plan": {"disabled": true},
		"general": {"model": "openai/gpt-5.6-terra#medium"},
		"explore": {"model": "openai/gpt-5.6-luna-fast#low"},
		"title": {"model": "openai/gpt-5.6-luna#low"},
		"summary": {"model": "openai/gpt-5.6-luna#low"}
	},
	"references": {
		"agent-browser": {
			"repository": "vercel-labs/agent-browser",
			"description": "Agent Browser source and command behavior."
		},
		"codex": {"repository": "openai/codex", "description": "Codex agent and protocol source."},
		"effect": {"repository": "Effect-TS/effect-smol", "description": "Effect application model and API source."},
		"effect-lsp": {"repository": "Effect-TS/language-service", "description": "Effect language-service source."},
		"legend-list": {"repository": "LegendApp/legend-list", "description": "Legend List source and behavior."},
		"lexical": {"repository": "facebook/lexical", "description": "Lexical editor source and behavior."},
		"localterm": {"repository": "millionco/localterm", "description": "Localterm source and terminal patterns."},
		"lydell-node-pty": {"repository": "lydell/node-pty", "description": "Lydell node-pty fork source."},
		"node-pty": {"repository": "microsoft/node-pty", "description": "Node PTY source and platform behavior."},
		"opencode": {"repository": "anomalyco/opencode", "description": "OpenCode source and configuration behavior."},
		"pi": {"repository": "earendil-works/pi", "description": "Pi agent source and protocol behavior."},
		"pierre-diffs": {"repository": "pierrecomputer/pierre", "description": "Pierre diff rendering source."},
		"portless": {"repository": "vercel-labs/portless", "description": "Portless source and routing behavior."},
		"react-doctor": {"repository": "millionco/react-doctor", "description": "React Doctor rules and source."},
		"superset": {"repository": "superset-sh/superset", "description": "Superset terminal application source."},
		"t3code": {"repository": "pingdotgg/t3code", "description": "T3 Code agent workbench source."},
		"tanstack-form": {"repository": "TanStack/form", "description": "TanStack Form source and APIs."},
		"tanstack-hotkey": {"repository": "TanStack/hotkeys", "description": "TanStack Hotkeys source and APIs."},
		"tanstack-router": {"repository": "TanStack/router", "description": "TanStack Router source and APIs."},
		"typescript": {"repository": "microsoft/TypeScript", "description": "TypeScript compiler source and behavior."},
		"vscode": {"repository": "microsoft/vscode", "description": "VS Code source and terminal integration."},
		"xterm-js": {"repository": "xtermjs/xterm.js", "description": "Xterm.js source and terminal behavior."}
	}
}
