{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"entry": ["**/main.*", ".opencode/instructions.ts"],
	"includeEntryExports": true,
	"ignorePatterns": [
		"**/*.gen.ts",
		"packages/components/src/components/svgs/**",
		"packages/components/src/components/ui/**",
		"tools/*/template/**"
	],
	"ignoreExports": [
		{"exports": ["*"], "file": "packages/*/src/schema.ts"},
		{"exports": ["*"], "file": "packages/components/src/components/**"},
		{"exports": ["default"], "file": ".opencode/instructions.ts"},
		{"exports": ["default"], "file": "tools/linter/src/oxlint-plugin.ts"}
	],
	"rules": {"require-suppression-reason": "error"}
}
