{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"includeEntryExports": true,
	"duplicates": {"minLines": 10, "ignore": ["apps/*/src/lib/atomRuntime.ts"]},
	"ignoreDependencies": [
		"@deslop/oxlint-rules",
		"@effect/atom-react",
		"@effect/platform-node",
		"@effect/vitest",
		"@lydell/node-pty",
		"agent-browser",
		"effect",
		"vite-plus"
	],
	"ignorePatterns": ["**/*.gen.ts"],
	"overrides": [{"files": ["**/schema.ts"], "rules": {"unused-types": "off"}}],
	"publicPackages": [
		"@deslop/agent",
		"@deslop/agent-browser",
		"@deslop/ai",
		"@deslop/components",
		"@deslop/git",
		"@deslop/opentelemetry",
		"@deslop/os",
		"@deslop/oxlint-rules",
		"@deslop/portless",
		"@deslop/scripts",
		"@deslop/terminal"
	],
	"security": {
		"categories": {"exclude": ["dynamic-regex", "header-injection", "path-traversal", "prototype-pollution", "ssrf"]}
	},
	"rules": {
		"private-type-leaks": "error",
		"unused-dev-dependencies": "error",
		"unused-optional-dependencies": "error",
		"unused-component-props": "error",
		"type-only-dependencies": "error",
		"test-only-dependencies": "error",
		"re-export-cycle": "error",
		"stale-suppressions": "error",
		"require-suppression-reason": "error",
		"coverage-gaps": "off",
		"unused-catalog-entries": "error",
		"empty-catalog-groups": "error",
		"unused-dependency-overrides": "error",
		"policy-violation": "error",
		"security-sink": "error"
	}
}
