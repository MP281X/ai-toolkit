{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"entry": ["**/main.*"],
	"includeEntryExports": true,
	"ignorePatterns": [
		".opencode/plugins/**",
		"**/*.gen.ts",
		"packages/components/src/components/svgs/**",
		"packages/components/src/components/ui/**",
		"tools/*/template/**",
		"tools/oxlint-rules/**"
	],
	"ignoreExports": [
		{"exports": ["*"], "file": "packages/*/src/schema.ts"},
		{"exports": ["*"], "file": "packages/components/src/components/**"},
		{"exports": ["default"], "file": "tools/oxlint-rules/src/oxlint-plugin.ts"}
	],
	"rules": {"require-suppression-reason": "error"}
}
