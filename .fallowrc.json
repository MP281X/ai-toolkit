{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"includeEntryExports": true,
	"duplicates": {"minLines": 10, "ignore": ["apps/*/src/lib/atomRuntime.ts"]},
	"boundaries": {
		"zones": [
			{"name": "app-portfolio", "patterns": ["apps/portfolio/**"]},
			{"name": "app-workbench", "patterns": ["apps/workbench/**"]},
			{"name": "package-agent", "patterns": ["packages/agent/**"]},
			{"name": "package-agent-browser", "patterns": ["packages/agent-browser/**"]},
			{"name": "package-ai", "patterns": ["packages/ai/**"]},
			{"name": "package-components", "patterns": ["packages/components/**"]},
			{"name": "package-git", "patterns": ["packages/git/**"]},
			{"name": "package-opentelemetry", "patterns": ["packages/opentelemetry/**"]},
			{"name": "package-os", "patterns": ["packages/os/**"]},
			{"name": "package-oxlint-rules", "patterns": ["packages/oxlint-rules/src/oxlint-plugin.ts"]},
			{"name": "package-portless", "patterns": ["packages/portless/**"]},
			{"name": "package-scripts", "patterns": ["packages/scripts/**"]},
			{"name": "package-terminal", "patterns": ["packages/terminal/**"]}
		],
		"rules": [
			{
				"from": "app-portfolio",
				"allow": [
					"app-portfolio",
					"package-agent",
					"package-agent-browser",
					"package-ai",
					"package-components",
					"package-git",
					"package-opentelemetry",
					"package-os",
					"package-oxlint-rules",
					"package-portless",
					"package-scripts",
					"package-terminal"
				]
			},
			{
				"from": "app-workbench",
				"allow": [
					"app-workbench",
					"package-agent",
					"package-agent-browser",
					"package-ai",
					"package-components",
					"package-git",
					"package-opentelemetry",
					"package-os",
					"package-oxlint-rules",
					"package-portless",
					"package-scripts",
					"package-terminal"
				]
			},
			{"from": "package-agent", "allow": ["package-agent"]},
			{"from": "package-agent-browser", "allow": ["package-agent-browser"]},
			{"from": "package-ai", "allow": ["package-ai"]},
			{"from": "package-components", "allow": ["package-components"]},
			{"from": "package-git", "allow": ["package-git"]},
			{"from": "package-opentelemetry", "allow": ["package-opentelemetry"]},
			{"from": "package-os", "allow": ["package-os"]},
			{"from": "package-oxlint-rules", "allow": ["package-oxlint-rules"]},
			{"from": "package-portless", "allow": ["package-portless"]},
			{"from": "package-scripts", "allow": ["package-scripts"]},
			{"from": "package-terminal", "allow": ["package-terminal"]}
		],
		"coverage": {
			"requireAllFiles": true,
			"allowUnmatched": [
				"**/routeTree.gen.ts",
				"packages/oxlint-rules/src/oxlint-plugin.test.ts",
				"scripts/**",
				"vite.config.ts"
			]
		}
	},
	"ignoreDependencies": [
		"@deslop/oxlint-rules",
		"@effect/atom-react",
		"@effect/platform-node",
		"agent-browser",
		"effect",
		"vite-plus"
	],
	"ignorePatterns": [".agents/repos/**", "**/*.gen.ts"],
	"overrides": [{"files": ["**/schema.ts"], "rules": {"unused-types": "off"}}],
	"publicPackages": [
		"@deslop/agent",
		"@deslop/agent-browser",
		"@deslop/ai",
		"@deslop/components",
		"@deslop/os",
		"@deslop/oxlint-rules"
	],
	"security": {
		"categories": {"exclude": ["dynamic-regex", "header-injection", "path-traversal", "prototype-pollution", "ssrf"]}
	},
	"rules": {
		"private-type-leaks": "error",
		"unused-dev-dependencies": "error",
		"unused-optional-dependencies": "error",
		"unused-component-props": "error",
		"type-only-dependencies": "error",
		"test-only-dependencies": "error",
		"re-export-cycle": "error",
		"stale-suppressions": "error",
		"require-suppression-reason": "error",
		"coverage-gaps": "off",
		"unused-catalog-entries": "error",
		"empty-catalog-groups": "error",
		"unused-dependency-overrides": "error",
		"policy-violation": "error",
		"security-sink": "error"
	}
}
