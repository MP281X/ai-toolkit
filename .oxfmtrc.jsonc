{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"ignorePatterns": ["**/*.gen.ts", "**/package.json"],

	"semi": false,
	"useTabs": true,
	"printWidth": 120,
	"singleQuote": true,
	"arrowParens": "avoid",
	"trailingComma": "none",
	"bracketSpacing": false,

	"sortTailwindcss": {"functions": ["cn"]},

	"sortImports": {
		"internalPattern": ["@/", "~/", "#", "@ai-toolkit/"],
		"customGroups": [
			{"groupName": "effectPackages", "elementNamePattern": ["@effect/**"], "selector": "external"},
			{"groupName": "effect", "elementNamePattern": ["effect"], "selector": "external"},
			{"groupName": "aiToolkit", "elementNamePattern": ["@ai-toolkit/**"], "selector": "external"},
			{"groupName": "aliases", "elementNamePattern": ["@/**", "#*", "~/**"], "selector": "internal"}
		],
		"groups": [
			["side_effect", "side_effect_style"],
			{"newlinesBetween": true},
			"builtin",
			{"newlinesBetween": true},
			"effectPackages",
			"effect",
			{"newlinesBetween": true},
			"external",
			{"newlinesBetween": true},
			"aiToolkit",
			{"newlinesBetween": true},
			"aliases",
			{"newlinesBetween": true},
			"parent",
			"sibling",
			"index"
		]
	}
}
