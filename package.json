{
  "name": "@deslop",
  "type": "module",
	"sideEffects": false,

	"engines": {"node": ">=24"},
	"packageManager": "pnpm@11.6.0",

	"deslop": {
		"dev": [
			"@deslop/portfolio#dev:client",
			"@deslop/portfolio#dev:server",
			"@deslop/workbench#dev:client",
			"@deslop/workbench#dev:server"
		]
	},

	"scripts": {
		"build": "vp run -r build",

		"fix": "fallow fix --yes && vp check --fix",
		"check": "vp check && fallow --only dead-code --format compact --fail-on-issues && fallow security --fail-on-issues",
		"test": "vp test",

		"shadcn": "cd packages/components && vpx shadcn@latest",

		"postinstall": "node scripts/clone-source-repos.ts"
	},

	"dependencies": {
		"effect": "^4.0.0-beta",
		"@effect/atom-react": "^4.0.0-beta",
		"@effect/platform-node": "^4.0.0-beta"
	},
	"devDependencies": {
		"typescript": "rc",
		"@types/node": "latest",
		"@types/react": "^19",
		"@types/react-dom": "^19",

		"fallow": "latest",
		"oxlint-plugin-react-doctor": "latest",
		"@deslop/oxlint-rules": "workspace:*",

		"vite": "catalog:",
		"vitest": "catalog:",
		"vite-plus": "catalog:"
	}
}
