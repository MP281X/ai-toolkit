{
	"name": "@deslop",
	"type": "module",
	"sideEffects": false,
	
	"engines": { "node": ">=26" },
	"packageManager": "pnpm@11.18.0",
	
	"deslop": {
		"dev": [
			"@deslop/portfolio#dev",
			"@deslop/workbench#dev"
		]
	},
	
	"scripts": {
		"build": "vp run -r build",
		
		"fix": "vp check --fix",
		"check": "vp check && fallow dead-code --unused-files --unused-exports --unused-types --format compact --fail-on-issues",
		"test": "vp test",
		
		"shadcn": "cd packages/components && vpx shadcn@latest",
		"upgrade": "sh -c 'rm -f pnpm-lock.yaml && find . -name node_modules -type d -prune -exec rm -rf {} + && vp install'",
		
		"prepare": "effect-tsgo patch --no-typescript --oxlint && node scripts/clone-source-repos.ts"
	},
	
	"dependencies": {
		"effect": "^4.0.0-beta",
		"@effect/atom-react": "^4.0.0-beta",
		"@effect/platform-node": "^4.0.0-beta"
	},
	"devDependencies": {
		"typescript": "latest",
		"@effect/tsgo": "latest",
		"@types/node": "latest",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		
		"fallow": "latest",
		"@effect/vitest": "^4.0.0-beta",
		"oxlint-plugin-react-doctor": "latest",
		
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
