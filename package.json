{
	"type": "module",
	"name": "@ai-toolkit",
	"sideEffects": false,
	"packageManager": "bun@1.3.10",
	"workspaces": ["apps/*", "packages/*", ".opencode"],

	"scripts": {
		"dev": "turbo run dev:server dev:client",
		"build": "NODE_ENV=production turbo run build:server build:client",

		"test": "turbo run test",
		"fix": "turbo run fix",
		"check": "turbo run check",

		"shadcn": "cd packages/components && bunx shadcn@latest"
	},

	"dependencies": {
		"effect": "^4.0.0-beta",
		"@effect/atom-react": "^4.0.0-beta",
		"@effect/platform-bun": "^4.0.0-beta",
		"@effect/openapi-generator": "^4.0.0-beta"
	},

	"devDependencies": {
		"turbo": "latest",
		"@effect/language-service": "latest",

		"typescript": "latest",
		"@typescript/native-preview": "latest",

		"oxfmt": "latest",
		"oxlint": "latest",
		"oxlint-tsgolint": "latest",
		"eslint-plugin-react-hooks": "latest",

		"@types/bun": "latest",
		"@types/react": "^19",
		"@types/react-dom": "^19"
	}
}
