{
	"name": "@deslop",
	"type": "module",
	"sideEffects": false,
	
	"engines": { "node": ">=26" },
	"packageManager": "pnpm@11.9.0",
	
	"deslop": {
		"dev": [
			"@deslop/portfolio#dev:client",
			"@deslop/portfolio#dev:server",
			"@deslop/workbench#dev:client",
			"@deslop/workbench#dev:server"
		]
	},
	
	"scripts": {
		"build": "vp run -r build",
		
		"fix": "vp check --fix",
		"check": "vp check && effect-tsgo diagnostics --project tsconfig.json --strict && fallow --only dead-code --format compact --fail-on-issues",
		"test": "vp test",
		
		"shadcn": "cd packages/components && vpx shadcn@latest",
		"upgrade": "sh -c 'rm -f pnpm-lock.yaml && find . -name node_modules -type d -prune -exec rm -rf {} + && vp install'",
		
		"postinstall": "node scripts/clone-source-repos.ts"
	},
	
	"dependencies": {
		"effect": "^4.0.0-beta",
		"@effect/atom-react": "^4.0.0-beta",
		"@effect/platform-node": "^4.0.0-beta"
	},
	"devDependencies": {
		"typescript": "latest",
		"@effect/tsgo": "latest",
		"@types/node": "latest",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		
		"fallow": "latest",
		"@effect/vitest": "^4.0.0-beta",
		"oxlint-plugin-react-doctor": "latest",
		
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
