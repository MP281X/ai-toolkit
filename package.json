{
	"name": "@deslop",
	"type": "module",
	"sideEffects": false,

	"engines": {"node": ">=24"},
	"packageManager": "pnpm@11.6.0",
	"workspaces": ["apps/*", "packages/*"],
	"deslop": {
		"portless": [
			"@deslop/portfolio#dev:client",
			"@deslop/portfolio#dev:server",
			"@deslop/workbench#dev:client",
			"@deslop/workbench#dev:server"
		]
	},

	"scripts": {
		"build": "vp run -r build",

		"fix": "vp check --fix",
		"check": "vp check",
		"test": "vp test",

		"shadcn": "cd packages/components && vp dlx shadcn@latest",

		"postinstall": "node scripts/clone-source-repos.ts"
	},

	"dependencies": {
		"effect": "^4.0.0-beta",
		"@effect/atom-react": "^4.0.0-beta",
		"@effect/platform-node": "^4.0.0-beta",
		"@effect/openapi-generator": "^4.0.0-beta"
	},
	"devDependencies": {
		"typescript": "latest",
		"@types/node": "latest",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
