{
	"name": "@deslop",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "vp run -r build",
		"check": "vp check && fallow dead-code --unused-files --unused-exports --unused-types --duplicate-exports --circular-deps --re-export-cycles --stale-suppressions --format compact --fail-on-issues",
		"fix": "vp check --fix",
		"prepare": "effect-tsgo patch --no-typescript --oxlint",
		"shadcn": "cd packages/components && vpx shadcn@latest",
		"test": "vp test",
		"upgrade": "sh -c 'rm -f pnpm-lock.yaml && find . -name node_modules -type d -prune -exec rm -rf {} + && vp install'"
	},
	"dependencies": {
		"@effect/atom-react": "^4.0.0-rc",
		"@effect/platform-node": "^4.0.0-rc",
		"effect": "^4.0.0-rc"
	},
	"devDependencies": {
		"@deslop/oxlint-rules": "workspace:*",
		"@effect/tsgo": "latest",
		"@effect/vitest": "^4.0.0-rc",
		"@opencode-ai/plugin": "beta",
		"@types/node": "latest",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"fallow": "latest",
		"oxlint-plugin-react-doctor": "latest",
		"typescript": "latest",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@11.22.0"
}
