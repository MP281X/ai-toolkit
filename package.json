{
  "name": "@deslop",
  "type": "module",
  "sideEffects": false,

  "engines": {"node": ">=24"},
  "packageManager": "pnpm@11.5.0",
  "workspaces": ["apps/*", "packages/*", ".opencode"],

  "scripts": {
		"build": "vp run -r build",
    "preview": "mprocs 'vp run @deslop/workbench#preview' 'vp run @deslop/portfolio#preview'",

    "fix": "vp check --fix",
    "check": "vp check",
    "test":"vp test",

    "shadcn": "cd packages/components && vp dlx shadcn@latest"
  },

  "dependencies": {
    "effect": "^4.0.0-beta",
    "@effect/atom-react": "^4.0.0-beta",
    "@effect/platform-node": "^4.0.0-beta",
    "@effect/openapi-generator": "^4.0.0-beta"
  },
  "devDependencies": {
    "typescript": "latest",
    "@types/node": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",

    "mprocs": "latest",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
